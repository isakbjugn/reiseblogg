  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.slug, p.title, p.content, p.published_at AS \"published_at!\", a.name AS forfatter\n        FROM post p\n        JOIN author a ON a.id = p.created_by\n        WHERE p.slug = $1 AND p.published_at IS NOT NULL\n        ",
